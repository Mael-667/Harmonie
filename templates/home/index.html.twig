{% extends 'base.html.twig' %}

{% block title %}Harmonie - Votre application de chat{% endblock %}

{% block meta_description %}Harmonie, l'application de chat communautaire pour créer des serveurs, discuter en canaux et rejoindre vos communautés.{% endblock %}

{% block body %}

<div id="title">
    <h1>Harmonie</h1>
    {% if is_granted("ROLE_USER") %}
        <p class="soustitre">Re-bienvenue {{ app.user.pseudo }} !</p>
    {% endif %}

    <div class="titleButtons">
        {% if is_granted("ROLE_USER") %}
            <a href="{{ path('app') }}" class="button crimsonButton">Accéder au chat</a>       
            <a href="{{ path('logout') }}" class="button">Se déconnecter</a>
        {% else %}
            <a href="{{ path('login') }}" class="button">Se connecter</a>
            <a href="{{ path('register') }}" class="button crimsonButton">S'inscrire</a>        
        {% endif %}
    </div>
</div>

{{ include('partials/footer.html.twig') }}

{% endblock %}
