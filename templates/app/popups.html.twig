{% macro popup(element) %}
        {# permet d'importer un block et de l'afficher directement #}
        {{ block(element) }}
{% endmacro %}

{% block popupNewServer %}
    <div id="popupNewServer" class="popup" style="display: none;">
        <div id="addServer">
            <h2>Ajouter un nouveau serveur</h2>
            <form action="" method="post" class="singleLineForm">
                <div class="field">
                    <label for="serverLink">Lien du serveur</label>
                    <input type="text" name="serverLink" id="serverLink" placeholder="harmonie.gg/1">
                </div>
                <button type="submit" class="button crimsonButton">Ajouter</button>
            </form>
        </div>
        <div id="createServer">
            <h2>Ou créez en un !</h2>
            <form action="/app/newServer" method="post">
                <label for="serverIcon" id="serverIconLabel">
                    <input type="file" name="serverIcon" id="serverIcon" accept="image/*">
                </label>
                <div class="singleLineForm">
                    <div class="field">
                        <label for="serverName">Nom serveur</label>
                        <input type="text" name="serverName" id="serverName" placeholder="Serveur de toi">
                    </div>
                    <button type="submit" class="button crimsonButton">Créer</button>
                </div>
            </form>
        </div>
    </div>

    <script>
    let fileInput = document.getElementById("serverIcon");
    let fileLabel = document.getElementById("serverIconLabel");
    fileInput.addEventListener("change", () => {
        fileLabel.style.background = `url(${URL.createObjectURL(fileInput.files[0])})`;
        fileLabel.style.color = `#ffffff00`;
    })

    let formNewServer = document.querySelector("#createServer>form")
    formNewServer.addEventListener("submit", (e) => {
        e.preventDefault();

        console.log(formNewServer);
        
    })
    </script>
{% endblock %}